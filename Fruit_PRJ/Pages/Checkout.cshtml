@page
@model Fruit_Store_PRJ.Pages.CheckoutModel
@{
    ViewData["Title"] = "Thanh toán đơn hàng";
}

<div class="container py-5">
    <div class="row g-5">
        <div class="col-md-7 col-lg-8">
            <h4 class="mb-3 fw-bold text-success">Thông tin giao hàng</h4>

            <form method="post" asp-page-handler="PlaceOrder" class="needs-validation">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="form-label">Họ và tên</label>
                        <input type="text" class="form-control" name="FullName" placeholder="" required>
                    </div>

                    <div class="col-sm-6">
                        <label class="form-label">Số điện thoại</label>
                        <input type="tel" class="form-control" name="Phone" placeholder="" required>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Địa chỉ nhận hàng</label>
                        <input type="text" class="form-control" name="Address" placeholder="Số nhà, tên đường, phường/xã..." required>
                    </div>
                </div>

                <hr class="my-4">

                <h4 class="mb-3 fw-bold text-success">Phương thức thanh toán</h4>

                <div class="my-3">
                    <div class="form-check mb-2">
                        <input id="cod" name="paymentMethod" type="radio" class="form-check-input" value="COD" checked required>
                        <label class="form-check-label" for="cod">Thanh toán khi nhận hàng (COD)</label>
                    </div>
                    <div class="form-check mb-2">
                        <input id="momo" name="paymentMethod" type="radio" class="form-check-input" value="MoMo" required>
                        <label class="form-check-label" for="momo">Ví điện tử MoMo</label>
                    </div>
                    <div class="form-check">
                        <input id="bank" name="paymentMethod" type="radio" class="form-check-input" value="Bank" required>
                        <label class="form-check-label" for="bank">Chuyển khoản ngân hàng</label>
                    </div>
                </div>

                <hr class="my-4">

                <button class="w-100 btn btn-success btn-lg shadow" type="submit">
                    Xác nhận đặt hàng
                </button>
            </form>
        </div>

        <div class="col-md-5 col-lg-4">
            <h4 class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-secondary">Đơn hàng của bạn</span>
                <span class="badge bg-success rounded-pill">@Model.OrderSummary.Count</span>
            </h4>

            <ul class="list-group mb-3 shadow-sm">
                @foreach (var item in Model.OrderSummary)
                {
                    <li class="list-group-item d-flex justify-content-between lh-sm py-3">
                        <div>
                            <h6 class="my-0 fw-bold">@item.Name</h6>
                            <small class="text-muted">Số lượng: @item.Quantity</small>
                        </div>
                        <span class="text-muted">@item.Total.ToString("N0")đ</span>
                    </li>
                }
                <li class="list-group-item d-flex justify-content-between py-3 bg-light">
                    <span class="fw-bold">Tổng cộng (VNĐ)</span>
                    <strong class="text-danger fs-5">@Model.GrandTotal.ToString("N0")đ</strong>
                </li>
            </ul>
        </div>
    </div>
</div>