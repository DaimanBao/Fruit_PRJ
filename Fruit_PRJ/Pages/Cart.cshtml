@page
@model Fruit_Store_PRJ.Pages.CartModel
@{
    ViewData["Title"] = "Giỏ hàng của bạn";
}

<div class="container py-5">
    <h2 class="mb-4 fw-bold text-success border-bottom pb-3">Giỏ Hàng</h2>
    <div class="row g-5">
        <div class="col-lg-8">
            <div class="table-responsive">
                <table class="table align-middle border-top">
                    <thead class="bg-light">
                        <tr>
                            <th scope="col" class="py-3 border-0">Sản phẩm</th>
                            <th scope="col" class="py-3 border-0">Giá</th>
                            <th scope="col" class="py-3 border-0 text-center">Số lượng</th>
                            <th scope="col" class="py-3 border-0 text-end">Tổng cộng</th>
                            <th scope="col" class="py-3 border-0"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Cart)
                        {
                            <tr>
                                <td class="py-4">
                                    <div class="d-flex align-items-center">
                                        <img src="@item.ImageUrl"
                                             class="rounded shadow-sm me-3" style="width: 70px; height: 70px; object-fit: cover;">
                                        <div>
                                            <h6 class="mb-0 fw-bold text-dark">@item.Name</h6>
                                            <small class="text-muted">Loại: @item.Category</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@item.Price.ToString("N0")đ</td>
                                <td style="width: 150px;">
                                    <form method="post" asp-page-handler="UpdateQuantity">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <div class="input-group input-group-sm border rounded">
                                            <button class="btn btn-link text-success" type="button" onclick="var input=this.parentNode.querySelector('input[type=number]');if(input.value>1)input.value--;">-</button>
                                            <input type="number" class="form-control border-0 text-center" value="@item.Quantity" name="quantity" min="1" readonly>
                                            <button class="btn btn-link text-success" type="button" onclick="var input=this.parentNode.querySelector('input[type=number]');input.value++;">+</button>
                                            <button type="submit" class="btn btn-sm btn-outline-secondary ms-2">Cập nhật</button>
                                        </div>
                                    </form>
                                </td>
                                <td class="text-end fw-bold text-success">@item.Total.ToString("N0")đ</td>
                                <td class="text-end">
                                    <form method="post" asp-page-handler="RemoveFromCart">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger border-0">
                                            <i class="bi bi-trash"></i> Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!Model.Cart.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-5">Giỏ hàng trống.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mt-4">
                <a href="/Products" class="text-success text-decoration-none">
                    <i class="bi bi-arrow-left"></i> Tiếp tục mua sắm
                </a>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm bg-light p-4">
                <h4 class="mb-4 fw-bold">Tổng đơn hàng</h4>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Tạm tính</span>
                    <span class="fw-bold">@Model.SubTotal.ToString("N0")đ</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Phí vận chuyển</span>
                    <span class="text-success">Miễn phí</span>
                </div>
                <hr class="my-3">
                <div class="d-flex justify-content-between mb-4">
                    <h5 class="fw-bold">Tổng cộng</h5>
                    <h5 class="fw-bold text-danger">@Model.GrandTotal.ToString("N0")đ</h5>
                </div>
                <form method="post" asp-page-handler="Checkout">
                    <div class="mb-4 p-3 bg-white rounded border">
                        <label class="form-label small fw-bold text-success"><i class="bi bi-calendar-event me-1"></i> Chọn lịch giao hàng:</label>
                        <div class="mb-2">
                            <input type="date" class="form-control form-control-sm" asp-for="DeliveryDate" required>
                        </div>
                        <div>
                            <select class="form-select form-select-sm" name="DeliveryTime">
                                <option value="morning">Sáng (08:00 - 12:00)</option>
                                <option value="afternoon">Chiều (13:30 - 17:30)</option>
                                <option value="evening">Tối (18:00 - 21:00)</option>
                            </select>
                        </div>
                        <div class="mt-2">
                            <small class="text-muted" style="font-size: 0.75rem;">* Chúng tôi giao hàng tất cả các ngày trong tuần.</small>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-success btn-lg w-100 shadow-sm">
                        Tiến hành thanh toán
                    </button>
                </form>
                <div class="mt-3 text-center">
                    <small class="text-muted">Chúng tôi chấp nhận:</small>
                    <div class="mt-1">
                        <span class="badge bg-white text-dark border me-1 px-2">MoMo</span>
                        <span class="badge bg-white text-dark border me-1 px-2">Visa/Master</span>
                        <span class="badge bg-white text-dark border px-2">COD</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>