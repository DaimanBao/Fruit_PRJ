@page
@model IndexModel
@{
    ViewData["Title"] = "Trang chủ";
}

<div class="container py-4">

    <div class="p-5 mb-4 bg-light rounded-3 border">
        <div class="container-fluid py-5">
            <h1 class="display-5 fw-bold text-success">Trái Cây Tươi Ngon Mỗi Ngày</h1>
            <p class="col-md-8 fs-4">Mang hương vị thiên nhiên đến ngôi nhà của bạn. Cam kết 100% hữu cơ, an toàn vệ sinh thực phẩm và giao hàng nhanh chóng trong 2h.</p>
            <a href="#san-pham" class="btn btn-success btn-lg" type="button">Mua Ngay</a>
        </div>
    </div>

    <div class="row align-items-md-stretch mb-5">
        <div class="col-md-4">
            <div class="h-100 p-4 text-white bg-success rounded-3">
                <h2>Tươi 100%</h2>
                <p>Trái cây được thu hoạch và vận chuyển ngay trong ngày để đảm bảo độ tươi ngon nhất.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="h-100 p-4 bg-light border rounded-3">
                <h2>Giao Hàng Nhanh</h2>
                <p>Đội ngũ shipper chuyên nghiệp, cam kết giao hàng nội thành chỉ trong vòng 2 giờ.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="h-100 p-4 bg-light border rounded-3">
                <h2>Đổi Trả Miễn Phí</h2>
                <p>Nếu không hài lòng về chất lượng, chúng tôi hỗ trợ đổi trả ngay lập tức không mất phí.</p>
            </div>
        </div>
    </div>

    <div id="san-pham" class="mb-4">
        <h2 class="pb-2 border-bottom mb-4 text-center text-uppercase text-secondary">Sản Phẩm Nổi Bật</h2>

        <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">

            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img src="https://images.unsplash.com/photo-1560806887-1e4cd0b6cbd6?w=400&q=80" class="card-img-top" alt="Táo Đỏ" style="height: 200px; object-fit: cover;">
                    <div class="card-body">
                        <h5 class="card-title text-success">Táo Đỏ Mỹ</h5>
                        <p class="card-text text-muted">Giòn, ngọt, nhiều nước, nhập khẩu trực tiếp.</p>
                        <h6 class="text-danger fw-bold">120.000đ / kg</h6>
                    </div>
                    <div class="card-footer bg-transparent border-top-0 d-grid gap-2">
                        <form method="post">
                            <input type="hidden" name="productId" value="1" />
                            <button type="submit" asp-page-handler="AddToCart" class="btn btn-outline-success w-100">
                                Thêm vào giỏ
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img src="https://images.unsplash.com/photo-1537640538965-17565236b589?w=400&q=80" class="card-img-top" alt="Cam Vàng" style="height: 200px; object-fit: cover;">
                    <div class="card-body">
                        <h5 class="card-title text-success">Cam Vàng Úc</h5>
                        <p class="card-text text-muted">Vỏ mỏng, mọng nước, giàu Vitamin C.</p>
                        <h6 class="text-danger fw-bold">85.000đ / kg</h6>
                    </div>
                    <div class="card-footer bg-transparent border-top-0 d-grid gap-2">
                        <form method="post">
                            <input type="hidden" name="productId" value="2" />
                            <button type="submit" asp-page-handler="AddToCart" class="btn btn-outline-success w-100">
                                Thêm vào giỏ
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img src="https://images.unsplash.com/photo-1587049359509-b788043259ac?w=400&q=80" class="card-img-top" alt="Dâu Tây" style="height: 200px; object-fit: cover;">
                    <div class="card-body">
                        <h5 class="card-title text-success">Dâu Tây Đà Lạt</h5>
                        <p class="card-text text-muted">Chín mọng, vị chua ngọt tự nhiên.</p>
                        <h6 class="text-danger fw-bold">250.000đ / hộp</h6>
                    </div>
                    <div class="card-footer bg-transparent border-top-0 d-grid gap-2">
                        <form method="post">
                            <input type="hidden" name="productId" value="3" />
                            <button type="submit" asp-page-handler="AddToCart" class="btn btn-outline-success w-100">
                                Thêm vào giỏ
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img src="https://images.unsplash.com/photo-1595111953930-58837130dfd0?w=400&q=80" class="card-img-top" alt="Nho Xanh" style="height: 200px; object-fit: cover;">
                    <div class="card-body">
                        <h5 class="card-title text-success">Nho Xanh Không Hạt</h5>
                        <p class="card-text text-muted">Giòn tan, ngọt lịm, chùm to đẹp mắt.</p>
                        <h6 class="text-danger fw-bold">180.000đ / kg</h6>
                    </div>
                    <div class="card-footer bg-transparent border-top-0 d-grid gap-2">
                        <form method="post">
                            <input type="hidden" name="productId" value="4" />
                            <button type="submit" asp-page-handler="AddToCart" class="btn btn-outline-success w-100">
                                Thêm vào giỏ
                            </button>
                        </form>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div class="bg-light border rounded-3 p-5 mt-5 text-center">
        <h3>Đăng ký nhận ưu đãi</h3>
        <p class="mb-4">Nhận ngay mã giảm giá 10% cho đơn hàng đầu tiên của bạn.</p>
        <div class="row justify-content-center">
            <div class="col-md-6">
                <form method="post" class="d-flex gap-2">
                    <input type="email" class="form-control" placeholder="Nhập email của bạn..." required name="email">
                    <button type="submit" asp-page-handler="Subscribe" class="btn btn-success text-nowrap">Đăng ký</button>
                </form>
            </div>
        </div>
    </div>

</div>
